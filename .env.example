# ------------------------------------------------------------------
# Konfigurasi API
# ------------------------------------------------------------------
# Mode demo (tanpa backend). Data disimpan di localStorage browser.
# Set ke "false" apabila ingin memakai backend Laravel/Express sendiri.
VITE_USE_MOCK=true

# Base URL backend. Dipakai ketika VITE_USE_MOCK=false.
# Contoh: http://127.0.0.1:8000/api  atau  https://api-booksales.example.com/api
VITE_API_BASE_URL=http://127.0.0.1:8000/api
